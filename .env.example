# Copy this file to .env and fill in the real values.
# .env is where your real passwords/keys live — never commit it.
#
# IMPORTANT: always wrap password values in double quotes.
# Without quotes, a "#" character (like the ones in the default
# password below) gets treated as the start of a comment and the
# rest of the value gets silently cut off.

PORT=3000

# ---- MongoDB Atlas (where chat/productions/status/bios are stored) ----
# See README.md "Setting up MongoDB Atlas" for how to get this.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority"

# ---- Cloudinary (where uploaded photos are stored) ----
# See README.md "Setting up Cloudinary" for how to get these three values.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- Site passwords ----
# Password required to enter the crew chat
CHAT_PASSWORD="angycore##889145"

# Password required for Core actions (edit productions, status, trailer, bios/photos)
CORE_PASSWORD="angycore##889145"
